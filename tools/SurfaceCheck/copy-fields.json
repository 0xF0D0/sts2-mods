  "MegaCrit.Sts2.Core.Models.Relics.BingBong._cardsToSkip": {
    "type": "System.Collections.Generic.HashSet`1[[MegaCrit.Sts2.Core.Models.CardModel, sts2, Version=0.1.0.0, Culture=neutral, PublicKeyToken=null]]",
    "risk": "collection",
